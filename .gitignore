# Ignore untracked generated and local files; these rules do not automatically untrack committed files.
# Python-generated files.
# Python caches, test reports, and build outputs can be regenerated.
__pycache__/
*.py[oc]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
build/
dist/
wheels/
*.egg-info

# Virtual environments.
# The local dependency environment is machine-specific and should not be committed.
.venv/
# Keep local tokens, passwords, and settings out of source control.
.env

# Local notes.
# Ignore local planning notes.
road_map.txt

# Generated ML artifacts and local data.
# Keep model weights and raw datasets out of the source Git history.
models/
data/
# Personal preparation and notes files are not part of the application source.
INTERVIEW_PREP.txt
q&a.html
