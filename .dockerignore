# Exclude these paths from the Docker build context to avoid copying local environments, secrets, and data.
# The container does not need Git history or the local virtual environment.
.git
.venv
# Exclude generated Python bytecode.
__pycache__
# Do not bundle local models/data; the app can download a missing local model from HF.
models/
data/
# Supply secrets through the deployment environment instead of baking .env into the image.
.env
# Exclude tests, GitHub workflows, the root README, and local metrics from the runtime image.
tests/
.github/
README.md
metrics.json
